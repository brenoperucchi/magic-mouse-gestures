# Apple Magic Mouse - allow user access to the HID raw device
# This enables running the gesture driver without root privileges
#
# KERNELS matches the parent HID device name: <bus>:<vendor>:<product>.<instance>
# Bus 0005 is Bluetooth and 0003 is USB. Apple uses two vendor IDs: over USB
# these mice report 05AC; over Bluetooth the Magic Mouse 2 reports 004C and the
# Magic Mouse 1 reports 05AC. Which one appears depends on the model and how it
# is connected, so every combination is listed.
#
# Keep in step with DEVICE_MODELS in magic_mouse_gestures.py and with
# HID_ID_PATTERN in install.sh.

# Magic Mouse 1 (product 030D)
KERNEL=="hidraw*", KERNELS=="0005:05AC:030D.*", MODE="0666"
KERNEL=="hidraw*", KERNELS=="0003:05AC:030D.*", MODE="0666"

# Magic Mouse 2 (product 0269)
KERNEL=="hidraw*", KERNELS=="0005:004C:0269.*", MODE="0666"
KERNEL=="hidraw*", KERNELS=="0005:05AC:0269.*", MODE="0666"
KERNEL=="hidraw*", KERNELS=="0003:05AC:0269.*", MODE="0666"

# Magic Mouse 2 USB-C (product 0323)
KERNEL=="hidraw*", KERNELS=="0005:004C:0323.*", MODE="0666"
KERNEL=="hidraw*", KERNELS=="0005:05AC:0323.*", MODE="0666"
KERNEL=="hidraw*", KERNELS=="0003:05AC:0323.*", MODE="0666"
